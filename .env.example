# PostgreSQL Connection String (Update with your Docker container details)
DATABASE_URL=postgresql://postgres:password@localhost:5432/chainmark

# 256-bit AES-GCM Master Key (64 hex characters)
CHAINMARK_MASTER_KEY=50cb277ad2cb09f8a68a764f7032ae18d426c50f39277c963659d6b7f2bd17d8

# Chainmark Gateway configuration
PORT=8000
HOST=0.0.0.0
FAIL_CLOSED=true

# Chainmark Cloud Hono API configuration (Option 2: Managed Cloud)
API_PORT=3001
DEPLOYMENT_MODE=cloud
AUTH_SECRET=replace-with-random-64-char-hex-secret-for-jwt-and-api-key-hmac

# Optional: Connect local Rust proxy Docker container to Cloud Portal
# CHAINMARK_CLOUD_URL=http://localhost:3001
# CHAINMARK_API_TOKEN=cm_live_your_token_here
