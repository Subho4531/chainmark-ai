# Copy to `.env.docker` and run with:
#   docker compose --env-file .env.docker up -d --build
#
# All values below are TEST-ONLY defaults. Do not reuse them in production.

# Host-side ports (chosen to avoid the local dev stack on 8000/3001/5432)
FRONTEND_PORT=8080
PROXY_PORT=8010
API_HTTP_PORT=3002
POSTGRES_PORT=5433

# PostgreSQL (inside the compose network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=chainmark_test_pw
POSTGRES_DB=chainmark

# AES-256-GCM vault master key (64 hex chars)
DOCKER_MASTER_KEY=50cb277ad2cb09f8a68a764f7032ae18d426c50f39277c963659d6b7f2bd17d8

# HMAC secret for session JWTs and API-key hashes (16+ chars)
DOCKER_AUTH_SECRET=chainmark-test-only-auth-secret-do-not-use-in-production-0001

# Optional cloud telemetry forwarding from the gateway to the API
# CHAINMARK_CLOUD_URL=http://api:3001
# CHAINMARK_API_TOKEN=cm_live_your_token_here
